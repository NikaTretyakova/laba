<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>App</title>
  </head>
  <body>
    <form action="" method="post">
        <input type="text" name="login" placeholder="Логин" required value="<%= login %>"/>
        <input type="text" name="password" placeholder="Пароль" required value="<%= password %>"/>
        <input type="text" name="last_name" placeholder="Фамилия" value="<%= last_name %>"/>
        <input type="text" name="first_name" placeholder="Имя" value="<%= first_name %>"/>
        <input type="text" name="patronymic" placeholder="Отчество" value="<%= patronymic %>"/>
        <button type="submit">Отправить</button>
    </form>
  </body>
</html>